txid = ee196513794ad620dcbac143882bdf578c3876d565888892964afe5a0b4c9f13

// ==================== pre-locktime failure: nLocktime = timelock - 1 (1577836799) ====================
// Same funding, key, and witness script as above, but the transaction's nLocktime is one second before
// the bond's timelock. The ECDSA signature below is valid (nLocktime is covered by the BIP 143 sighash,
