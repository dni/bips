funding vout    = 0
funding amount  = 1000000
funding scriptPubKey = 00203152cc8772555c3aec6fa8a4a521723533d09da47e99ac1f2cdd6adb0e21dbc9
destination scriptPubKey = 00140000000000000000000000000000000000000000
destination amount = 999000
nSequence (non-final) = 0xfffffffe

// ==================== mature spend: nLocktime = bond timelock (1577836800) ====================
sighash preimage (BIP 143) = 
sighash                    = 477778db7c5b8df2f1470134d3d622d5b1cad63619bc0cee73321c96adad6600
signature (DER)            = 3045022100ab38c0b615783ba63a2bfb36b254fd35be950dd7a0b80aacad9ac7af4cd7998902202d5f0815affd09f7e992996e8f7b541a519bea73b40d4ba4b7fcc5b748b1a818

